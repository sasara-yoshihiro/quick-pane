<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuickPane.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QuickPane.Controls"
    xmlns:helpers="using:QuickPane.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="QuickPane 設定">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,6" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,4,0,8" />
            </Style>
        </Grid.Resources>

        <!-- タイトルバー -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <Image Width="16" Height="16" Source="ms-appx:///Assets/QuickPane.png" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="QuickPane 設定" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="全般" Tag="General">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="外観" Tag="Appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="バージョン情報" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer Padding="36,0,36,0" VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="1000" Padding="0,12,0,36">
                    <!-- 全般 -->
                    <StackPanel x:Name="GeneralPage" Spacing="4">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="全般" />

                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="呼び出し" />
                        <toolkit:SettingsCard Description="ランチャーの表示・非表示を切り替えるキーです。入力欄をクリックして、キーの組み合わせを押してください (修飾キー必須)。" Header="ホットキー">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE765;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <controls:HotkeyBox x:Name="HotkeyInput" />
                        </toolkit:SettingsCard>
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind helpers:Bind.IsNotEmpty(ViewModel.HotkeyError), Mode=OneWay}"
                            Message="{x:Bind ViewModel.HotkeyError, Mode=OneWay}"
                            Severity="Warning" />

                        <toolkit:SettingsCard Description="ランチャーを表示する位置です。画面からはみ出す場合は画面内に収まるよう補正します。" Header="表示位置">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7C4;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox MinWidth="200" SelectedIndex="{x:Bind ViewModel.PositionIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="マウスカーソル付近" />
                                <ComboBoxItem Content="画面中央" />
                            </ComboBox>
                        </toolkit:SettingsCard>

                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="動作" />
                        <toolkit:SettingsCard Description="オフにすると、アイテムを起動した後もランチャーを表示したままにします。" Header="アイテム起動後にランチャーを閉じる">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8BB;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.CloseAfterLaunch, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="Windows にサインインしたときに QuickPane を自動で起動します。" Header="Windows サインイン時に自動起動">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7E8;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                    </StackPanel>

                    <!-- 外観 -->
                    <StackPanel x:Name="AppearancePage" Spacing="4" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="外観" />

                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="テーマ" />
                        <toolkit:SettingsCard Description="ランチャーと設定画面の配色です。" Header="テーマ">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE771;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox MinWidth="200" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="システム設定に従う" />
                                <ComboBoxItem Content="ライト" />
                                <ComboBoxItem Content="ダーク" />
                            </ComboBox>
                        </toolkit:SettingsCard>

                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="レイアウト" />
                        <toolkit:SettingsCard Description="ランチャーに表示するアイコンの大きさです。" Header="アイコンサイズ">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8B9;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox MinWidth="200" SelectedIndex="{x:Bind ViewModel.IconSizeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="小" />
                                <ComboBoxItem Content="中" />
                                <ComboBoxItem Content="大" />
                            </ComboBox>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="ランチャーの 1 行に並べるアイテムの数です。" Header="1 行あたりのアイテム数">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xF0E2;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <NumberBox
                                MinWidth="200"
                                LargeChange="2"
                                Maximum="{x:Bind ViewModel.MaxColumns}"
                                Minimum="{x:Bind ViewModel.MinColumns}"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.Columns, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                    </StackPanel>

                    <!-- バージョン情報 -->
                    <StackPanel x:Name="AboutPage" Spacing="4" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="バージョン情報" />

                        <toolkit:SettingsCard Margin="0,20,0,0" Description="{x:Bind ViewModel.Version}" Header="QuickPane">
                            <toolkit:SettingsCard.HeaderIcon>
                                <ImageIcon Source="ms-appx:///Assets/QuickPane.png" />
                            </toolkit:SettingsCard.HeaderIcon>
                        </toolkit:SettingsCard>

                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="データ" />
                        <toolkit:SettingsCard Description="{x:Bind ViewModel.DataDirectory}" Header="データフォルダ (設定・登録アイテム)">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Button Click="OpenDataFolder_Click" Content="フォルダを開く" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="アイコンが更新されない場合に、キャッシュを削除して再取得します。" Header="アイコンキャッシュ">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE72C;" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <Button Click="ClearIconCache_Click" Content="削除して再取得" />
                        </toolkit:SettingsCard>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
