<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="QuickPane.Views.ItemEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:QuickPane.Helpers"
    xmlns:local="using:QuickPane.Views"
    Title="{x:Bind ViewModel.Title}"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
    PrimaryButtonText="保存">

    <ScrollViewer MinWidth="440" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,0,4,0" Spacing="12">
            <!-- アイコンのプレビューと名前 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid Width="36" Height="36">
                        <FontIcon
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind local:ItemEditDialog.GlyphFor(ViewModel.Path), Mode=OneWay}"
                            Visibility="{x:Bind helpers:Bind.VisibleIfNull(Preview.Icon), Mode=OneWay}" />
                        <Image Source="{x:Bind Preview.Icon, Mode=OneWay}" Stretch="Uniform" />
                    </Grid>
                </Border>
                <TextBox
                    x:Name="NameBox"
                    Grid.Column="1"
                    Header="名前 (必須)"
                    PlaceholderText="ランチャーに表示する名前"
                    Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Header="パス (必須)"
                    LostFocus="Path_LostFocus"
                    PlaceholderText="ファイル・フォルダのフルパス、または URL"
                    Text="{x:Bind ViewModel.Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DropDownButton
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Content="参照">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Click="BrowseFile_Click" Text="ファイルを選択...">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="BrowseFolder_Click" Text="フォルダを選択...">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <TextBox
                Header="引数"
                PlaceholderText="(任意)"
                Text="{x:Bind ViewModel.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Header="作業フォルダ"
                    PlaceholderText="(任意) 未指定の場合はパスのあるフォルダ"
                    Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Click="BrowseWorkingDirectory_Click"
                    Content="参照" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Header="アイコン"
                    LostFocus="Icon_LostFocus"
                    PlaceholderText="(任意) 未指定の場合はパスから取得 例: shell32.dll,3"
                    Text="{x:Bind ViewModel.IconPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Click="BrowseIcon_Click"
                    Content="参照" />
            </Grid>

            <CheckBox Content="管理者として実行" IsChecked="{x:Bind ViewModel.RunAsAdmin, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
